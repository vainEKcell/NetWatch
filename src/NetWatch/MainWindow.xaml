<Window x:Class="NetWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetWatch"
        Title="NetWatch"
        Width="1400" Height="880" MinWidth="1150" MinHeight="680"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="12.5"
        Icon="Assets/app.ico">

    <Window.Resources>
        <Style x:Key="ProcRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RiskByte}" Value="3">
                    <Setter Property="Background" Value="#2E1517"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskByte}" Value="2">
                    <Setter Property="Background" Value="#2A2113"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AlertRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter Property="Background" Value="#332215"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SeriousRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Serious}" Value="True">
                    <Setter Property="Background" Value="#2A2113"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ================= 顶栏 ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/app.ico" Width="26" Height="26"/>
                    <TextBlock Text="NetWatch" FontSize="16" FontWeight="Bold" Margin="9,0,18,0" VerticalAlignment="Center"/>
                    <Button Command="{Binding TogglePauseCommand}" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="{DynamicResource top.pause}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Paused}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource top.resume}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <CheckBox Content="{DynamicResource top.hideLoopback}" IsChecked="{Binding HideLoopback}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox Content="{DynamicResource top.onlyFlagged}" IsChecked="{Binding OnlyFlagged}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnSearchChanged" Padding="7,4"/>
                            <TextBlock x:Name="SearchHint" Text="{DynamicResource top.searchHint}"
                                       Foreground="{StaticResource DimBrush}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Grid.Column="1" Text="🔍" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource DimBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{DynamicResource top.totalUp}" Foreground="{StaticResource DimBrush}" FontSize="10.5"/>
                        <TextBlock Text="{Binding TotalUpText}" Foreground="{StaticResource GreenBrush}"
                                   FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{DynamicResource top.totalDown}" Foreground="{StaticResource DimBrush}" FontSize="10.5"/>
                        <TextBlock Text="{Binding TotalDownText}" Foreground="{StaticResource BlueBrush}"
                                   FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="{DynamicResource top.session}" Foreground="{StaticResource DimBrush}" FontSize="10.5"/>
                        <TextBlock Text="{Binding SessionText}" Foreground="{StaticResource DimBrush}" FontSize="12"/>
                    </StackPanel>
                    <local:TrafficChart x:Name="Chart" Width="230" Height="40" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ================= 可疑横幅 ================= -->
        <Border x:Name="Banner" DockPanel.Dock="Top" Background="#33E3A836" Padding="14,6"
                Cursor="Hand" MouseLeftButtonUp="OnBannerClick"
                Visibility="{Binding BannerVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BannerText}" Foreground="#F0C674" FontWeight="SemiBold"
                       ToolTip="{DynamicResource top.onlyFlagged}"/>
        </Border>

        <!-- ================= 状态栏 ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding ConnCountText}" Foreground="{StaticResource DimBrush}"/>
                    <TextBlock Text="{Binding BlockedCountText}" Foreground="{StaticResource DimBrush}" Margin="18,0,0,0"/>
                    <TextBlock Text="{Binding BlockedConnCountText}" Foreground="{StaticResource RedBrush}" Margin="18,0,0,0"/>
                    <TextBlock Text="{Binding DnsAlertCountText}" Foreground="{StaticResource AmberBrush}" Margin="18,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"/>
            </DockPanel>
        </Border>

        <!-- ================= 主区：8 页 ================= -->
        <TabControl x:Name="MainTabs" TabStripPlacement="Left" Margin="8">

            <!-- ========== 1. 总览 ========== -->
            <TabItem Header="{DynamicResource tab.overview}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="410"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="ProcessGrid" Grid.Column="0" ItemsSource="{Binding Rows}"
                              RowStyle="{StaticResource ProcRow}" Sorting="OnProcessSort"
                              SelectedItem="{Binding Selected}" SelectionMode="Single"
                              EnableRowVirtualization="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource cm.related}" Command="{Binding ShowRelatedEventsCommand}"/>
                                <MenuItem Header="{DynamicResource cm.copy}" Command="{Binding CopyCommand}"/>
                                <MenuItem Header="{DynamicResource cm.folder}" Command="{Binding FolderCommand}"/>
                                <MenuItem Header="{DynamicResource cm.intel}" Command="{Binding QueryFileIntelCommand}"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource cm.kill}" Command="{Binding KillCommand}"/>
                                <MenuItem Header="{DynamicResource cm.taskmgr}" Command="{Binding TaskMgrCommand}"/>
                                <MenuItem Header="{DynamicResource cm.copyPid}" Command="{Binding CopyPidCommand}"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource cm.stopService}" Command="{Binding StopServicesCommand}"/>
                                <MenuItem Header="{DynamicResource cm.disableService}" Command="{Binding DisableServicesCommand}"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource cm.block}" Command="{Binding BlockCommand}"/>
                                <MenuItem Header="{DynamicResource cm.unblock}" Command="{Binding UnblockCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{Binding [col.risk], RelativeSource={RelativeSource AncestorType=DataGrid}}" Width="46" SortMemberPath="Risk">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Fill="{Binding RiskBrush}" ToolTip="{Binding RiskText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding IconSource}" Width="18" Height="18"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{Binding [col.process], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Name}" Width="*" SortMemberPath="Name"/>
                            <DataGridTextColumn Header="{Binding [col.pid], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Pid}" Width="56" SortMemberPath="Pid"
                                                ElementStyle="{StaticResource CellRight}"/>
                            <DataGridTextColumn Header="{Binding [col.vendor], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Company}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellDim}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{Binding [col.downSpeed], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding DownSpeedText}" Width="90"
                                                SortMemberPath="DownSpeedBytes">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}">
                                        <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{Binding [col.upSpeed], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding UpSpeedText}" Width="90"
                                                SortMemberPath="UpSpeedBytes">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}">
                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{Binding [col.downTotal], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding DownTotalText}" Width="86"
                                                SortMemberPath="DownTotalBytes" ElementStyle="{StaticResource CellRight}"/>
                            <DataGridTextColumn Header="{Binding [col.upTotal], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding UpTotalText}" Width="86"
                                                SortMemberPath="UpTotalBytes" ElementStyle="{StaticResource CellRight}"/>
                            <DataGridTextColumn Header="{Binding [col.conn], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ConnCount}" Width="50"
                                                SortMemberPath="ConnCount" ElementStyle="{StaticResource CellRight}"/>
                            <DataGridTemplateColumn Header="{Binding [col.blocked], RelativeSource={RelativeSource AncestorType=DataGrid}}" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="🚫" ToolTip="{DynamicResource cm.block}"
                                                   Visibility="{Binding Blocked, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <Grid Grid.Column="2">
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="{DynamicResource btn.block}" Command="{Binding BlockCommand}"
                                            Background="#3A1D1E" BorderBrush="#63272A"/>
                                    <Button Content="{DynamicResource btn.unblock}" Command="{Binding UnblockCommand}" Margin="8,0,0,0"/>
                                    <Button Command="{Binding ToggleTrustCommand}" Margin="8,0,0,0"
                                            ToolTip="{DynamicResource bl.allowTitle}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="{DynamicResource btn.trust}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTrusted}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource btn.untrust}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{DynamicResource btn.copy}" Command="{Binding CopyCommand}" Margin="8,0,0,0"/>
                                    <Button Content="{DynamicResource btn.folder}" Command="{Binding FolderCommand}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding DetailIcon}" Width="34" Height="34" VerticalAlignment="Center"/>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DetailName}" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding DetailCompany}" Foreground="{StaticResource DimBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DetailPid}" Foreground="{StaticResource DimBrush}" Margin="0,6,0,0"/>
                                        <TextBlock Text="{DynamicResource d.path}" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="{Binding DetailPath}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock Text="{DynamicResource d.parent}" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="{Binding DetailParent}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock Text="{DynamicResource d.user}" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="{Binding DetailUser}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock Text="{DynamicResource d.cmdline}" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="{Binding DetailCmdLine}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DimBrush}"
                                                   ToolTip="{Binding DetailCmdLine}"/>
                                        <TextBlock Text="{DynamicResource d.services}" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="{Binding DetailServices}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock Text="{DynamicResource d.identity}" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="{Binding DetailIdentity}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock Text="{DynamicResource d.signature}" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="{Binding DetailSignature}" Foreground="{Binding DetailSignatureBrush}"/>
                                        <TextBlock Text="{DynamicResource d.verdict}" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="{Binding DetailVerdict}" Foreground="{Binding DetailVerdictBrush}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding DetailRisks}" Margin="0,3,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"
                                                               Foreground="{StaticResource DimBrush}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{DynamicResource btn.related}" Command="{Binding ShowRelatedEventsCommand}"
                                                Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{DynamicResource d.conns}" Style="{StaticResource SectionHeader}"/>
                                        <DataGrid ItemsSource="{Binding SelectedConns}" MaxHeight="190"
                                                  CanUserSortColumns="False" RowHeight="26">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{Binding [col.remote], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Remote}" Width="*"/>
                                                <DataGridTextColumn Header="{Binding [col.local], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Local}" Width="120"/>
                                                <DataGridTextColumn Header="{Binding [col.proto], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ProtoText}" Width="48"/>
                                                <DataGridTextColumn Header="{Binding [col.state], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding State}" Width="92"/>
                                                <DataGridTextColumn Header="{Binding [col.scope], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Scope}" Width="62"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="{DynamicResource d.recentDns}" Style="{StaticResource SectionHeader}"/>
                                        <ItemsControl ItemsSource="{Binding DetailDns}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource DimBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource d.placeholder}"
                                   Foreground="{StaticResource DimBrush}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========== 2. 目的地排行 ========== -->
            <TabItem Header="{DynamicResource tab.destinations}">
                <DataGrid ItemsSource="{Binding Destinations}" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [col.dest], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Display}" Width="2*"/>
                        <DataGridTextColumn Header="{Binding [col.destScope], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Scope}" Width="70"/>
                        <DataGridTextColumn Header="{Binding [col.upTotalDest], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding UpText}" Width="100"
                                            ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="{Binding [col.downTotalDest], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding DownText}" Width="100"
                                            ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="{Binding [col.lastSeen], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding LastText}" Width="90"
                                            ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="{Binding [col.involved], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ProcessesText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ========== 3. DNS 安全 ========== -->
            <TabItem Header="{DynamicResource tab.dns}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource dns.servers}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding DnsServersText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource dns.proxy}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding ProxyText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource dns.winhttp}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding WinHttpText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource Card}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource dns.hosts}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding HostsText}" TextWrapping="Wrap"/>
                                <Button Content="{DynamicResource dns.openHosts}" Command="{Binding OpenHostsCommand}"
                                        Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                                       Text="{DynamicResource dns.streamTitle}"/>
                            <DataGrid ItemsSource="{Binding DnsStream}" RowStyle="{StaticResource AlertRow}"
                                      CanUserSortColumns="False" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [col.time], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding TimeText}" Width="70"/>
                                    <DataGridTextColumn Header="{Binding [col.process], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Process}" Width="150"/>
                                    <DataGridTextColumn Header="{Binding [col.domain], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Domain}" Width="*"/>
                                    <DataGridTextColumn Header="{Binding [col.result], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Ips}" Width="1.2*"/>
                                    <DataGridTextColumn Header="{Binding [col.alertNote], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding AlertText}" Width="1.4*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellDim}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="{DynamicResource dns.checkTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <RadioButton x:Name="RbAli" Content="{DynamicResource dns.ali}" IsChecked="True" GroupName="doh"
                                             Checked="OnDohProviderChanged" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <RadioButton x:Name="RbPod" Content="{DynamicResource dns.dnspod}" GroupName="doh"
                                             Checked="OnDohProviderChanged" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <RadioButton x:Name="RbCf" Content="{DynamicResource dns.cloudflare}" GroupName="doh"
                                             Checked="OnDohProviderChanged" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <TextBox Text="{Binding DohProbeDomains, UpdateSourceTrigger=PropertyChanged}" Width="360"
                                         ToolTip="{DynamicResource doh.probeTip}"/>
                                <Button Content="{DynamicResource dns.checkRun}" Command="{Binding DohRunCommand}"
                                        IsEnabled="{Binding DohRunning, Converter={StaticResource InvBool}}"
                                        Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DohStatusText}" Foreground="{StaticResource DimBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <DataGrid ItemsSource="{Binding DohResults}" MaxHeight="170" CanUserSortColumns="False"
                                      RowHeight="28" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [col.domain], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Domain}" Width="160"/>
                                    <DataGridTextColumn Header="{Binding [col.localResult], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding LocalIps}" Width="1.1*"/>
                                    <DataGridTextColumn Header="{Binding [col.refResult], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding RefIps}" Width="1.1*"/>
                                    <DataGridTemplateColumn Header="{Binding [col.verdict], RelativeSource={RelativeSource AncestorType=DataGrid}}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== 4. 监听端口 ========== -->
            <TabItem Header="{DynamicResource tab.ports}">
                <DataGrid ItemsSource="{Binding Ports}" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [col.proto], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ProtoText}" Width="55"/>
                        <DataGridTextColumn Header="{Binding [col.port], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Port}" Width="70"
                                            ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="{Binding [col.bind], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Bind}" Width="150"/>
                        <DataGridTextColumn Header="{Binding [col.exposure], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding BindText}" Width="110"/>
                        <DataGridTextColumn Header="{Binding [col.pid], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Pid}" Width="60"
                                            ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="{Binding [col.process], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Process}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ========== 5. 事件流 ========== -->
            <TabItem Header="{DynamicResource tab.events}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{DynamicResource ev.export}" Command="{Binding ExportCommand}"/>
                        <Button Content="{DynamicResource ev.clear}" Command="{Binding ClearEventsCommand}" Margin="8,0,0,0"/>
                        <Border Background="#33E3A836" CornerRadius="4" Padding="10,4"
                                Margin="14,0,0,0" Visibility="{Binding EventsFilterVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding EventsFilterText}" Foreground="#F0C674"/>
                        </Border>
                        <Button Content="{DynamicResource ev.clearFilter}" Command="{Binding ClearEventsFilterCommand}" Margin="6,0,0,0"
                                Visibility="{Binding EventsFilterVisible, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{DynamicResource ev.note}"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Events}" CanUserSortColumns="False">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource cm.filterPid}" Click="OnCmFilterEventPid"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [col.time], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding TimeText}" Width="70"/>
                            <DataGridTemplateColumn Header="{Binding [col.kind], RelativeSource={RelativeSource AncestorType=DataGrid}}" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KindText}" Foreground="{Binding KindBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{Binding [col.process], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Process}" Width="170"/>
                            <DataGridTextColumn Header="{Binding [col.target], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Detail}" Width="*"/>
                            <DataGridTextColumn Header="{Binding [col.bytes], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding BytesText}" Width="90"
                                                ElementStyle="{StaticResource CellRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ========== 6. 拦截名单 ========== -->
            <TabItem Header="{DynamicResource tab.blocklist}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{DynamicResource bl.unblockSel}" Command="{Binding UnblockAppCommand}"/>
                        <Button Content="{DynamicResource bl.refresh}" Command="{Binding RefreshBlockedCommand}" Margin="8,0,0,0"/>
                        <TextBlock Text="{DynamicResource bl.note}"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding BlockedApps}" CanUserSortColumns="False"
                              SelectedItem="{Binding SelectedBlocked}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [col.app], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding DisplayName}" Width="240"/>
                            <DataGridTextColumn Header="{Binding [col.path], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="{Binding [col.rules], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding RulesText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource bl.allowTitle}"
                                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                <Button Content="{DynamicResource bl.removeSel}" Command="{Binding RemoveTrustedCommand}" Margin="14,0,0,0"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding TrustedApps}" SelectedItem="{Binding SelectedTrustedApp}"
                                     MaxHeight="140" BorderThickness="0" Background="Transparent"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== 7. 网络配置 ========== -->
            <TabItem Header="{DynamicResource tab.network}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Adapters}" CanUserSortColumns="False" MaxHeight="190">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [col.adapter], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Name}" Width="170"/>
                            <DataGridTextColumn Header="{Binding [col.status], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Status}" Width="70"/>
                            <DataGridTextColumn Header="{Binding [col.ips], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IpsText}" Width="1.2*"/>
                            <DataGridTextColumn Header="{Binding [col.gateway], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding GwText}" Width="*"/>
                            <DataGridTextColumn Header="{Binding [col.dns], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding DnsText}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource cfg.proxy}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding ProxyText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding WinHttpText}" TextWrapping="Wrap" Foreground="{StaticResource DimBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource cfg.hosts}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding HostsText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                                       Text="{DynamicResource cfg.historyTitle}"/>
                            <DataGrid ItemsSource="{Binding ConfigHistory}" RowStyle="{StaticResource SeriousRow}"
                                      CanUserSortColumns="False" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [col.time], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding TimeText}" Width="130"/>
                                    <DataGridTextColumn Header="{Binding [col.what], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding What}" Width="140"/>
                                    <DataGridTextColumn Header="{Binding [col.old], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Old}" Width="*"/>
                                    <DataGridTextColumn Header="{Binding [col.new], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding New}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== 8. 设置 ========== -->
            <TabItem Header="{DynamicResource tab.settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource set.language}" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="CbLanguage" MinWidth="160" SelectionChanged="OnLanguageChanged">
                                        <ComboBoxItem Content="{DynamicResource set.langAuto}" Tag="auto"/>
                                        <ComboBoxItem Content="中文" Tag="zh"/>
                                        <ComboBoxItem Content="English" Tag="en"/>
                                    </ComboBox>
                                    <TextBlock Text="NetWatch v1.0.1" Foreground="{StaticResource DimBrush}"
                                               VerticalAlignment="Center" Margin="18,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource cfg.privacyTitle}" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource cfg.baselineKeep}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CbBaselineDays" MinWidth="92" SelectionChanged="OnBaselineDaysChanged">
                                        <ComboBoxItem Content="30" Tag="30"/>
                                        <ComboBoxItem Content="90" Tag="90" IsSelected="True"/>
                                        <ComboBoxItem Content="180" Tag="180"/>
                                        <ComboBoxItem Content="365" Tag="365"/>
                                        <ComboBoxItem Content="{DynamicResource common.unlimited}" Tag="0"/>
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource cfg.evidenceKeep}" VerticalAlignment="Center" Margin="18,0,6,0"/>
                                    <ComboBox x:Name="CbEvidenceDays" MinWidth="92" SelectionChanged="OnEvidenceDaysChanged">
                                        <ComboBoxItem Content="3" Tag="3"/>
                                        <ComboBoxItem Content="7" Tag="7" IsSelected="True"/>
                                        <ComboBoxItem Content="14" Tag="14"/>
                                        <ComboBoxItem Content="30" Tag="30"/>
                                        <ComboBoxItem Content="90" Tag="90"/>
                                        <ComboBoxItem Content="{DynamicResource common.unlimited}" Tag="0"/>
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource cfg.evidenceCap}" VerticalAlignment="Center" Margin="18,0,6,0"/>
                                    <ComboBox x:Name="CbEvidenceCap" MinWidth="92" SelectionChanged="OnEvidenceCapChanged">
                                        <ComboBoxItem Content="256 MB" Tag="256"/>
                                        <ComboBoxItem Content="512 MB" Tag="512" IsSelected="True"/>
                                        <ComboBoxItem Content="1 GB" Tag="1024"/>
                                        <ComboBoxItem Content="2 GB" Tag="2048"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkPauseBaseline" Content="{DynamicResource cfg.pauseBaseline}"
                                              Checked="OnPauseBaselineChanged" Unchecked="OnPauseBaselineChanged"
                                              Margin="18,0,0,0" VerticalAlignment="Center"
                                              ToolTip="{DynamicResource cfg.pauseBaseline}"/>
                                    <Button Content="{DynamicResource cfg.cleanNow}" Click="OnCleanupNow" Margin="18,0,0,0"/>
                                    <TextBlock Text="{Binding StorageInfo}" Foreground="{StaticResource DimBrush}"
                                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding AuditStatusText}" Foreground="{StaticResource DimBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="{DynamicResource cfg.enableAudit}" Click="OnEnableAudit" Margin="12,0,0,0"
                                            ToolTip="{DynamicResource cfg.auditOn}"/>
                                    <TextBlock Text="{Binding SysmonStatusText}" Foreground="{StaticResource DimBrush}"
                                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
