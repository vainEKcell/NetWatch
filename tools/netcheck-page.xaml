            <!-- ========== 4. 网络体检 ========== -->
            <Grid x:Name="PageNetCheck" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 运行行：按钮 + 进度 + 检测内容说明（整体一个板块） -->
                <StackPanel Grid.Row="0" Margin="0,18,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource ncv.run}" Command="{Binding NetworkCheckCommand}"
                                IsEnabled="{Binding CheckRunning, Converter={StaticResource InvBool}}"/>
                        <TextBlock Text="{Binding CheckProgressText}" Foreground="{StaticResource DimBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource ncv.note}" Foreground="{StaticResource DimBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- 主体：左列 NAT / 带宽测速 / 延迟，右列 综合分析 / 体检结论 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ncv.nat}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding NatText}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource ncv.external}" Foreground="{StaticResource DimBrush}" FontSize="11" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NatExternal}" Foreground="{StaticResource DimBrush}"
                                               FontSize="11" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <TextBlock Text="{Binding NatDetailText}" Foreground="{StaticResource DimBrush}" FontSize="11"
                                           TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource sp.title}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding SpeedProgressText}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding SpeedBestText}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SpeedNodeText}" Foreground="{StaticResource DimBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding UploadText}" Foreground="{StaticResource DimBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="{DynamicResource sp.desc}" Foreground="{StaticResource DimBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ncv.ping}" Style="{StaticResource SectionHeader}"/>
                                <!-- 列头 -->
                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [col.pingTarget], Source={x:Static services:Loc.Instance}}" FontSize="10.5" Foreground="{StaticResource DimBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [col.avg], Source={x:Static services:Loc.Instance}}" FontSize="10.5" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding [col.jitter], Source={x:Static services:Loc.Instance}}" FontSize="10.5" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding [col.loss], Source={x:Static services:Loc.Instance}}" FontSize="10.5" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding [col.p95], Source={x:Static services:Loc.Instance}}" FontSize="10.5" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding [col.quality], Source={x:Static services:Loc.Instance}}" FontSize="10.5" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PingRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource RowAltBrush}" CornerRadius="3" Padding="6,4" Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.3*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="52"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Target}" FontSize="11.5" ToolTip="{Binding TargetIp}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AvgText}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding JitterText}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding LossText}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding P95Text}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding QualityText}" FontSize="11.5" Foreground="{Binding QualityBrush}"
                                                               FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ncv.analysis}" Style="{StaticResource SectionHeader}"/>
                                <ItemsControl ItemsSource="{Binding ScenarioRows}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Verdict}" Foreground="{Binding Brush}"
                                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding PeakText}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,4,0,0"/>
                                <Separator Margin="0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource ncv.link}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,1"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LinkTypeText}" FontSize="11" Margin="10,1,0,1"/>
                                    <TextBlock Grid.Row="1" Text="{DynamicResource ncv.linkspeed}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LinkSpeedText}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="10,1,0,1"/>
                                    <TextBlock Grid.Row="2" Text="{DynamicResource ncv.wifi.signal}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WifiSignalText}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="10,1,0,1"/>
                                    <TextBlock Grid.Row="3" Text="{DynamicResource ncv.wifi.ssid}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,1"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WifiSsidText}" Foreground="{StaticResource DimBrush}" FontSize="11"
                                               Margin="10,1,0,1" TextTrimming="CharacterEllipsis" ToolTip="{Binding WifiSsidText}"/>
                                    <TextBlock Grid.Row="4" Text="{DynamicResource ncv.mtu}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,1"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MtuText}" Foreground="{StaticResource DimBrush}" FontSize="11"
                                               Margin="10,1,0,1" TextTrimming="CharacterEllipsis" ToolTip="{Binding MtuText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ncv.conclusion}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding CheckVerdictText}" FontSize="15" FontWeight="Bold"
                                           Foreground="{Binding CheckVerdictBrush}" Margin="0,2,0,4"/>
                                <ItemsControl ItemsSource="{Binding CheckAdvices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" FontSize="11"
                                                       Foreground="{DynamicResource DimBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

